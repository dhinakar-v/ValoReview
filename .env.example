# Copy to .env and fill in. .env is gitignored; this file is not.

# Path to an Oodle runtime, used to decompress REPLAYDATA and CHECKPOINT blocks.
# Optional: vendor/, an installed UE4/UE5 game, or --oodle-dll all work too.
# See vendor/README.md for where to find one.
VRF_OODLE_DLL=

# The position decoder built by runners/build-decoder.bat.
# Optional: vendor/parser/, the csharp/ build output, or --parser-exe all work
# too. Only positions need it; nothing else does. See README, "The decoder".
VRF_PARSER_EXE=

# Riot API key, for scripts that call Riot's own endpoints.
# fetch_assets.py does not need one -- valorant-api.com is unauthenticated.
RIOT_API=

# Directory the match list scans for .vrf replays.
# Optional: defaults to Demos/ under the project root.
DEMO_PATH=
