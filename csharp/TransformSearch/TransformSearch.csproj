<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A derivation tool, not part of the pipeline.

    Riot rotates the payload transform every build, and upstream publishes one
    only after somebody reverse-engineers the client. When a capture arrives on
    a build nobody has published a transform for, this searches for its 64-bit
    mixing function against a corpus captured by csharp/patches (see
    docs/payload-transform-13-04.md for the method and what calibrates it).

    It references nothing: not csharp/parser, not ValoReview code. Its whole input
    is a JSONL corpus of {bit count, seed, payload hex}, so it builds and runs
    on a machine that has neither.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>transform-search</AssemblyName>
    <RootNamespace>TransformSearch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

</Project>
