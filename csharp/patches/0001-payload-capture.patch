diff --git a/src/Replay.Encoding/PayloadEncryption/VersionedTransforms/ValorantPayloadCaptureTransform.cs b/src/Replay.Encoding/PayloadEncryption/VersionedTransforms/ValorantPayloadCaptureTransform.cs
