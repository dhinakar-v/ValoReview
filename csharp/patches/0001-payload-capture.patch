+        // The capture transform is registered only while VRF_PAYLOAD_CAPTURE
+        // names a sink, and that condition is load-bearing rather than tidy:
+        // it passes payloads through untouched, so registering it
+        // unconditionally would turn an unsupported build from a refusal by
+        // name into a parse that succeeds and produces rubbish -- the one
+        // failure this registry is shaped to avoid.
+        if (ValorantPayloadCaptureTransform.SinkPath is null)
+        {
+            return new PayloadTransformRegistry(published);
+        }
+
+        // It *replaces* any published transform claiming the same branch, so a
+        // capture can be taken from a build whose answer is already known.
+        // That is the only way to calibrate a recovery attempt: with no
+        // known-good run to compare against, a 0% score on a new build says
+        // nothing about whether the method works.
+        var branch = ValorantPayloadCaptureTransform.CaptureBranch;
+        var kept = published.Where(t => !t.SupportedReplayVersions.Contains(branch, StringComparer.Ordinal));
+        return new PayloadTransformRegistry([.. kept, new ValorantPayloadCaptureTransform()]);
+    }
 
